# Match the default esp32-s3-devkitc-1-N8 PlatformIO board. A real board with a
# different flash size must select its own board/configuration before upload.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# Endpoint reports must be observable through the board's native USB connection.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
