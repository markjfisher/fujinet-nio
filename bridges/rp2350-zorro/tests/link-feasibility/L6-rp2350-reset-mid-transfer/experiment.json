    "analyzer": {"sample_rate_hz": 12000000, "capture_ms": 1000, "channels": ["D0", "D1", "D2", "D3", "D4", "D5"], "trigger": "D3=f", "pretrigger_percent": 10, "arm_ms": 1500}
  },
  "evidence": ["partial-slot/reset/reload result lines", "RP2350 and ESP32 transcripts", "analyzer capture", "build/link-feasibility/L6/report.json"],
