    "esp32s3": {"SCLK": 12, "MOSI": 11, "MISO": 13, "CS": 10, "READY": 9, "DATA_AVAILABLE": 8},
    "analyzer": "CH1=SCLK, CH2=MOSI, CH3=MISO, CH4=CS, CH5=READY, CH6=DATA_AVAILABLE; connect analyzer GND to the shared ground."
  },
  "run_profile": {
    "cases": [
      {"id": "partial-before-reset", "operation": "fault_partial", "sequence": 1, "length": 64, "pattern": "slip-bytes", "slot_bytes": 32, "expect_status": "partial_injected"},
