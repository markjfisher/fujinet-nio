{
  "id": "L1",
  "title": "Arbitrary binary round-trip",
  "status": "implemented-infrastructure",
  "scenario": 1,
  "execution": {
    "kind": "round_trip",
    "automated": true
  },
  "purpose": "Proves the candidate link is byte-transparent across deterministic binary payload families and representative packet lengths.",
  "rp2350": {
    "preset": "link-rp2350",
    "target": "link_rp2350"
  },
  "esp32": {
    "project": "lab/esp32-link",
    "environment": "link-esp32s3"
  },
  "wiring": {
    "rp2350": {
      "SCLK": 2,
      "MOSI": 3,
      "MISO": 4,
      "CS": 5,
      "READY": 6,
      "DATA_AVAILABLE": 7
    },
    "esp32s3": {
      "SCLK": 12,
      "MOSI": 11,
      "MISO": 13,
      "CS": 10,
      "READY": 9,
      "DATA_AVAILABLE": 8
    },
    "analyzer": "Connect GND plus SCLK, MOSI, MISO, CS, READY and DATA_AVAILABLE to six analyzer channels; select channels in the local bench record."
  },
  "run_profile": {
    "packets": 12,
    "cases": [
      {
        "id": "empty",
        "length": 0,
        "pattern": "zero",
        "sequence": 1
      },
      {
        "id": "one-zero",
        "length": 1,
        "pattern": "zero",
        "sequence": 2
      },
      {
        "id": "one-ff",
        "length": 1,
        "pattern": "ff",
        "sequence": 3
      },
      {
        "id": "small-increment",
        "length": 16,
        "pattern": "increment",
        "sequence": 4
      },
      {
        "id": "small-alternating",
        "length": 16,
        "pattern": "alternating",
        "sequence": 5
      },
      {
        "id": "small-slip",
        "length": 16,
        "pattern": "slip-bytes",
        "sequence": 6
      },
      {
        "id": "medium-zero",
        "length": 64,
        "pattern": "zero",
        "sequence": 7
      },
      {
        "id": "medium-ff",
        "length": 64,
        "pattern": "ff",
        "sequence": 8
      },
      {
        "id": "medium-random",
        "length": 64,
        "pattern": "fixed-random",
        "sequence": 9
      },
      {
        "id": "large-alternating",
        "length": 128,
        "pattern": "alternating",
        "sequence": 10
      },
      {
        "id": "maximum-random",
        "length": 240,
        "pattern": "fixed-random",
        "sequence": 11
      },
      {
        "id": "maximum-slip",
        "length": 240,
        "pattern": "slip-bytes",
        "sequence": 12
      }
    ],
    "analyzer": {
      "sample_rate_hz": 12000000,
      "capture_ms": 500,
      "channels": [
        "D0",
        "D1",
        "D2",
        "D3",
        "D4",
        "D5"
      ],
      "trigger": "D3=f",
      "pretrigger_percent": 10
    },
    "lengths": [
      0,
      1,
      16,
      64,
      240
    ],
    "patterns": [
      "zero",
      "ff",
      "increment",
      "alternating",
      "fixed-random",
      "slip-bytes"
    ]
  },
  "evidence": [
    "RP2350 USB result line",
    "ESP32-S3 USB log",
    "optional analyzer capture",
    "build/link-feasibility/L1/report.json"
  ]
}
