{
  "id": "L9",
  "title": "Recovery soak",
  "status": "implemented-infrastructure",
  "scenario": 9,
  "purpose": "Repeats transfers with deterministic resets, pauses and reconnects to find stale-data, framing or recovery failures.",
  "rp2350": {
    "preset": "link-rp2350",
    "target": "link_rp2350"
  },
  "esp32": {
    "project": "lab/esp32-link",
    "environment": "link-esp32s3"
  },
  "wiring": {
    "rp2350": {
      "SCLK": 2,
      "MOSI": 3,
      "MISO": 4,
      "CS": 5,
      "READY": 6,
      "DATA_AVAILABLE": 7
    },
    "esp32s3": {
      "SCLK": 12,
      "MOSI": 11,
      "MISO": 13,
      "CS": 10,
      "READY": 9,
      "DATA_AVAILABLE": 8
    },
    "analyzer": "Connect GND plus SCLK, MOSI, MISO, CS, READY and DATA_AVAILABLE to six analyzer channels; select channels in the local bench record."
  },
  "run_profile": {
    "packets": 10000,
    "cycles": 100,
    "faults": [
      "reset",
      "pause",
      "reconnect"
    ]
  },
  "evidence": [
    "RP2350 USB result line",
    "ESP32-S3 USB log",
    "optional analyzer capture",
    "build/link-feasibility/L9/report.json"
  ]
}
