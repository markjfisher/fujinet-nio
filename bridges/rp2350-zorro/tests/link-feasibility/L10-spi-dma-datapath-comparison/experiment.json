  "id": "L10",
  "title": "SPI DMA datapath comparison",
  "status": "implemented",
  "scenario": 10,
  "purpose": "Compares the existing RP2350 CPU-driven SPI slot transfer with SPI-DREQ DMA using the unchanged fixed-slot envelope, ownership signals and ESP endpoint. It measures RP-side phase means without claiming a production ABI or extrapolating beyond the W2 breadboard fixture.",
