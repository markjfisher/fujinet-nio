{
  "id": "L4",
  "title": "Reverse independent ESP-to-RP transfer",
  "status": "implemented",
  "scenario": 4,
  "purpose": "Proves that the ESP32-S3 can originate an independently scheduled opaque packet and the RP2350 validates it.",
  "rp2350": {
    "preset": "link-rp2350",
    "target": "link_rp2350"
  },
  "esp32": {
    "project": "lab/esp32-link",
    "environment": "link-esp32s3"
  },
  "wiring": {
    "rp2350": {
      "SCLK": 2,
      "MOSI": 3,
      "MISO": 4,
      "CS": 5,
      "READY": 6,
      "DATA_AVAILABLE": 7
    },
    "esp32s3": {
      "SCLK": 12,
      "MOSI": 11,
      "MISO": 13,
      "CS": 10,
      "READY": 9,
      "DATA_AVAILABLE": 8
    },
    "analyzer": "Connect GND plus SCLK, MOSI, MISO, CS, READY and DATA_AVAILABLE to six analyzer channels; select channels in the local bench record."
  },
  "run_profile": {
    "packets": 6,
    "direction": "esp-to-rp",
    "cases": [
      {
        "id": "autonomous-1",
        "operation": "receive",
        "length": 0,
        "pattern": "zero",
        "sequence": 1,
        "expect_status": "received"
      },
      {
        "id": "autonomous-2",
        "operation": "receive",
        "length": 0,
        "pattern": "zero",
        "sequence": 2,
        "expect_status": "received"
      },
      {
        "id": "autonomous-3",
        "operation": "receive",
        "length": 0,
        "pattern": "zero",
        "sequence": 3,
        "expect_status": "received"
      },
      {
        "id": "autonomous-4",
        "operation": "receive",
        "length": 0,
        "pattern": "zero",
        "sequence": 4,
        "expect_status": "received"
      },
      {
        "id": "autonomous-5",
        "operation": "receive",
        "length": 0,
        "pattern": "zero",
        "sequence": 5,
        "expect_status": "received"
      },
      {
        "id": "autonomous-6",
        "operation": "receive",
        "length": 0,
        "pattern": "zero",
        "sequence": 6,
        "expect_status": "received"
      }
    ],
    "analyzer": {
      "sample_rate_hz": 12000000,
      "capture_ms": 500,
      "channels": [
        "D0",
        "D1",
        "D2",
        "D3",
        "D4",
        "D5"
      ],
      "trigger": "D3=f",
      "pretrigger_percent": 10
    },
    "lengths": [
      1,
      64,
      240
    ]
  },
  "evidence": [
    "RP2350 USB result line",
    "ESP32-S3 USB log",
    "optional analyzer capture",
    "build/link-feasibility/L4/report.json"
  ],
  "execution": {
    "kind": "round_trip",
    "automated": true
  }
}
