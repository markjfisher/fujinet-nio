            "bus_bit": 1
          },
          {
            "label": "D0",
            "channel": "D0",
            "bus_bit": 0
          }
        ]
      },
      {
        "label": "/AS",
        "role": "strobe",
        "channel": "D7",
        "polarity": "active-low"
      }
