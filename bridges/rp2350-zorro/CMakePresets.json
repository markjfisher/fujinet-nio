{
  "version": 3,
  "configurePresets": [
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "BRIDGE_MODE": "host",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-release",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "firmware",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/firmware",
      "cacheVariables": {
        "BRIDGE_MODE": "firmware",
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "waveshare_core2350b",
        "PICO_PLATFORM": "rp2350-arm-s"
      }
    },
    {
      "name": "stimulus-rp2040",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stimulus-rp2040",
      "cacheVariables": {
        "BRIDGE_MODE": "stimulus",
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico",
        "PICO_PLATFORM": "rp2040",
        "STIMULUS_EXPERIMENT": "generator-check",
        "STIMULUS_TARGET": "feasibility_stimulus"
      }
    },
    {
      "name": "dut-c0-rp2350",
      "inherits": "firmware",
      "binaryDir": "${sourceDir}/build/dut-c0-rp2350"
    },
    {
      "name": "stimulus-c0-rp2040",
      "inherits": "stimulus-rp2040",
      "binaryDir": "${sourceDir}/build/stimulus-c0-rp2040",
      "cacheVariables": {
        "STIMULUS_EXPERIMENT": "C0-idle",
        "STIMULUS_TARGET": "feasibility_c0_idle"
      }
    },
    {
      "name": "stimulus-c1-rp2040",
      "inherits": "stimulus-rp2040",
      "binaryDir": "${sourceDir}/build/stimulus-c1-rp2040",
      "cacheVariables": {
        "STIMULUS_EXPERIMENT": "C1-patterns",
        "STIMULUS_TARGET": "feasibility_c1_patterns",
        "STIMULUS_WORDS": "30",
        "STIMULUS_SAMPLE_COUNT": "28",
        "STIMULUS_STORAGE": "flash"
      }
    },
    {
      "name": "stimulus-c2-rp2040",
      "inherits": "stimulus-rp2040",
      "binaryDir": "${sourceDir}/build/stimulus-c2-rp2040",
      "cacheVariables": {
        "STIMULUS_EXPERIMENT": "C2-held-active",
        "STIMULUS_TARGET": "feasibility_c2_held_active",
        "STIMULUS_WORDS": "12",
        "STIMULUS_SAMPLE_COUNT": "1",
        "STIMULUS_STORAGE": "flash"
      }
    },
    {
      "name": "stimulus-c3-rp2040",
      "inherits": "stimulus-rp2040",
      "binaryDir": "${sourceDir}/build/stimulus-c3-rp2040",
      "cacheVariables": {
        "STIMULUS_EXPERIMENT": "C3-sampling-window",
        "STIMULUS_TARGET": "feasibility_c3_sampling_window",
        "STIMULUS_WORDS": "26",
        "STIMULUS_SAMPLE_COUNT": "4",
        "STIMULUS_STORAGE": "flash"
      }
    },
    {
      "name": "stimulus-c4-rp2040",
      "inherits": "stimulus-rp2040",
      "binaryDir": "${sourceDir}/build/stimulus-c4-rp2040",
      "cacheVariables": {
        "STIMULUS_EXPERIMENT": "C4-repetition",
        "STIMULUS_TARGET": "feasibility_c4_repetition",
        "STIMULUS_WORDS": "32",
        "STIMULUS_SAMPLE_COUNT": "20",
        "STIMULUS_STORAGE": "flash"
      }
    },
    {
      "name": "dut-c5-rp2350",
      "inherits": "firmware",
      "binaryDir": "${sourceDir}/build/dut-c5-rp2350",
      "cacheVariables": {
        "DUT_CAPTURE_W1": "ON"
      }
    },
    {
      "name": "stimulus-c5-rp2040",
      "inherits": "stimulus-rp2040",
      "binaryDir": "${sourceDir}/build/stimulus-c5-rp2040",
      "cacheVariables": {
        "STIMULUS_EXPERIMENT": "C5-width-control",
        "STIMULUS_TARGET": "feasibility_c5_width_control",
        "STIMULUS_WORDS": "10",
        "STIMULUS_SAMPLE_COUNT": "18",
        "STIMULUS_STORAGE": "flash",
        "STIMULUS_OUTPUT_BASE": "2",
        "STIMULUS_OUTPUT_PINS": "21",
        "STIMULUS_DRIVE_PINS": "21",
        "STIMULUS_SET_BASE": "2",
        "STIMULUS_SET_PINS": "0",
        "STIMULUS_AS_PIN": "18",
        "STIMULUS_IDLE_VALUE": "983040",
        "STIMULUS_USE_DMA": "1",
        "STIMULUS_OUTPUT_WORD_COUNT": "45",
        "STIMULUS_SHIFTCTRL": "524288"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "firmware",
      "configurePreset": "firmware"
    },
    {
      "name": "stimulus-rp2040",
      "configurePreset": "stimulus-rp2040"
    },
    {
      "name": "dut-c0-rp2350",
      "configurePreset": "dut-c0-rp2350"
    },
    {
      "name": "stimulus-c0-rp2040",
      "configurePreset": "stimulus-c0-rp2040"
    },
    {
      "name": "stimulus-c1-rp2040",
      "configurePreset": "stimulus-c1-rp2040"
    },
    {
      "name": "stimulus-c2-rp2040",
      "configurePreset": "stimulus-c2-rp2040"
    },
    {
      "name": "stimulus-c3-rp2040",
      "configurePreset": "stimulus-c3-rp2040"
    },
    {
      "name": "stimulus-c4-rp2040",
      "configurePreset": "stimulus-c4-rp2040"
    },
    {
      "name": "dut-c5-rp2350",
      "configurePreset": "dut-c5-rp2350"
    },
    {
      "name": "stimulus-c5-rp2040",
      "configurePreset": "stimulus-c5-rp2040"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
