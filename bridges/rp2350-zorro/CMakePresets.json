{
  "version": 3,
  "configurePresets": [
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "BRIDGE_MODE": "host",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-release",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "firmware",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/firmware",
      "cacheVariables": {
        "BRIDGE_MODE": "firmware",
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "waveshare_core2350b",
        "PICO_PLATFORM": "rp2350-arm-s"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "firmware",
      "configurePreset": "firmware"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
