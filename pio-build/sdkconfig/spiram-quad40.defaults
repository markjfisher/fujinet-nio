# Original ESP32 FujiNet modules: quad PSRAM, matching the 40 MHz flash clock.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_CACHE_WORKAROUND=y
# The cache workaround's libc needs IRAM; keep optional WiFi code in flash.
CONFIG_ESP_WIFI_IRAM_OPT=n
# NIO does not use himem; leave the full mapped region available to the heap.
CONFIG_SPIRAM_BANKSWITCH_ENABLE=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
